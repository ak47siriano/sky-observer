# Sky Observer Environment Configuration (Offline-First & Privacy-First)
SKYOBSERVER_ENV=production

# Network binding for Docker host port publishing:
# - Default 127.0.0.1 keeps the app reachable ONLY on this machine.
# - Set to 0.0.0.0 (or your LAN IP) ONLY on a trusted private LAN and after enabling API authentication.
SKYOBSERVER_HOST=127.0.0.1
SKYOBSERVER_PORT=8080

# Offline-first default (true = zero outbound weather/radar requests).
# Set to false for Hybrid Mode (Open-Meteo NWP + RainViewer past precipitation radar).
SKYOBSERVER_OFFLINE_MODE=true

SKYOBSERVER_CONFIG_PATH=/config/config.yaml
SKYOBSERVER_DATA_DIR=/data
SKYOBSERVER_DEVICE=auto
SKYOBSERVER_MAX_GPU_MEMORY_FRACTION=0.85
SKYOBSERVER_MEM_LIMIT=8G
TZ=UTC

# Optional: Linux USB webcam device for docker-compose.usb.yml
SKYOBSERVER_VIDEO_DEVICE=/dev/video0

# Optional: Caddy HTTPS reverse proxy settings for docker-compose.https.yml (LAN PWA install)
SKYOBSERVER_HTTPS_PORT=8443
SKYOBSERVER_LAN_HOST=localhost
